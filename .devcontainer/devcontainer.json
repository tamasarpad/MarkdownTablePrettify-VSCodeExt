{
  // Markdown Table Prettifier — agent devcontainer
  //
  // Generated by the project-container skill. Safe to edit and commit.
  // STANDALONE: anyone with Docker + `npm i -g @devcontainers/cli` can run
  //   devcontainer up --workspace-folder .
  // No skill or agent is required — the lifecycle scripts below bootstrap
  // everything (see .devcontainer/README.md).
  "name": "Markdown Table Prettifier",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // Host-side prep before the container is created (idempotent). Creates the
  // shared agent home at ~/.devcontainers/MarkdownTablePrettify-VSCodeExt and seeds a
  // commit-only git identity from the host.
  "initializeCommand": "bash .devcontainer/scripts/initialize.sh",

  // Run as the non-root node user (UID 1000, matches a typical Linux host user)
  "remoteUser": "node",
  "containerUser": "node",
  "updateRemoteUserUID": true,

  // Source code bind mount (host-visible, so git push happens from the host)
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  // Persistent agent home: Claude/Codex auth + config survive container recreation
  "mounts": [
    "source=${localEnv:HOME}/.devcontainers/MarkdownTablePrettify-VSCodeExt,target=/home/node,type=bind,consistency=cached"
  ],

  // Dev server ports (generator: set to the published ports, or [] / {} if none)
  "forwardPorts": [],
  "portsAttributes": {},

  "containerEnv": {
    "DEVCONTAINER": "true",
    "PROJECT_NAME": "MarkdownTablePrettify-VSCodeExt",
    "TZ": "Europe/Budapest"
  },

  // Lifecycle: first-run install + per-start verification (both idempotent)
  "postCreateCommand": "bash -lc '/workspace/.devcontainer/scripts/post-create.sh'",
  "postStartCommand": "bash -lc '/workspace/.devcontainer/scripts/post-start.sh'",

  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // Docker run arguments:
  //   --name      deterministic container name (docker exec / headless usage)
  //   --hostname  shown in the shell prompt inside the container
  //   -p          publish dev server (generator inserts after hostname, or omits)
  //   --cpus/--memory  guardrails so a runaway process can't take down the host
  "runArgs": [
    "--name=MarkdownTablePrettify-VSCodeExt-dev",
    "--hostname=markdown-table-prettify-dev",
    "--cpus=4",
    "--memory=8g"
  ],

  "overrideCommand": true
}
