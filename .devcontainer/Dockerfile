# Markdown Table Prettifier — agent devcontainer image
#
# Generated by the project-container skill. Safe to edit and commit.
# Standalone: built automatically by `devcontainer up`; no skill required.
#
# Design notes:
#   - Base node:22-bookworm (full): ships git/curl/wget/build tools.
#   - NO nvm. Single Node runtime keeps the npm global prefix simple.
#   - NPM_CONFIG_PREFIX points at a node-owned global dir so the `node` user can
#     `npm install -g` AND Codex's built-in updater (which runs `npm install -g`)
#     stays consistent. This dir lives in the image layer; post-create.sh
#     reinstalls Codex on rebuild. Claude installs to ~/.local/bin (its own
#     installer) which persists in the mounted home.
#   - Do NOT set the npm prefix to ~/.local: that shadows the Codex updater and
#     breaks if nvm is ever added.

FROM node:22-bookworm

# node-owned global npm prefix (see design notes above)
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$NPM_CONFIG_PREFIX/bin:/home/node/.local/bin:$PATH

# System tools (survive container recreation; lost dotfiles are reseeded by post-create)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      gnupg \
      sudo \
      less \
      ripgrep \
      jq \
      tree \
      tmux \
      mc \
      openssh-client \
      python3 \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

# VS Code integration tests launch Electron on a virtual X display.
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb xauth \
      libasound2 libatk-bridge2.0-0 libatspi2.0-0 libdbus-1-3 \
      libgbm1 libglib2.0-0 libgtk-3-0 libnss3 libnspr4 \
      libx11-xcb1 libxcomposite1 libxcursor1 libxdamage1 \
      libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxshmfence1 libxss1 \
    && rm -rf /var/lib/apt/lists/*

# node user gets passwordless sudo (occasional root ops inside the sandbox)
RUN echo "node ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Global npm tools into the node-owned prefix, then hand ownership to node so
# both manual installs and self-updaters can write there.
RUN mkdir -p "$NPM_CONFIG_PREFIX" \
    && npm install -g npm@latest \
    && chown -R node:node "$NPM_CONFIG_PREFIX"

# Workspace mount point
RUN mkdir -p /workspace && chown node:node /workspace

USER node
WORKDIR /workspace

# Keep the container running; agents attach via docker exec / devcontainer.sh enter
CMD ["sleep", "infinity"]
